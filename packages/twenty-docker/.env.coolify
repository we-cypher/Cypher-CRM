# Paste this into Coolify → Environment Variables (or save as .env next to docker-compose.yml).
# Replace every REPLACE_ME value before the first deploy. Do not commit real secrets.

# Local/Coolify image tag for this Cypher build. Not an official twentycrm/twenty tag.
TAG=crm-wecypher

# Public URL Coolify / your domain will serve. No trailing slash.
SERVER_URL=https://crm.wecypher.com

# Postgres — password must be letters/numbers only (no @ # : /).
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=c14ffdbe65ddc1c52b5e9c32d0a011a7
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default

REDIS_URL=redis://redis:6379

# openssl rand -base64 32
# Losing ENCRYPTION_KEY loses OAuth tokens, TOTP, and encrypted config.
ENCRYPTION_KEY=QmPydhNihvnw0jVQbonR8I7EpsnXig8nDmo/IBcMM1U=
FALLBACK_ENCRYPTION_KEY=
APP_SECRET=

STORAGE_TYPE=local

# Server runs migrations and cron registration. Worker must not.
DISABLE_DB_MIGRATIONS=false
DISABLE_CRON_JOBS_REGISTRATION=false

# Phone-home and cloud extras — keep off for a closed self-host.
TELEMETRY_ENABLED=false
ALLOW_REQUESTS_TO_TWENTY_ICONS=false
MARKETPLACE_CATALOG_SYNC_CRON_ENABLED=false
ANALYTICS_ENABLED=false
IS_BILLING_ENABLED=false
EXCEPTION_HANDLER_DRIVER=CONSOLE
SUPPORT_DRIVER=NONE
EMAIL_DRIVER=LOGGER

AUTH_GOOGLE_ENABLED=false
AUTH_MICROSOFT_ENABLED=false
MESSAGING_PROVIDER_GMAIL_ENABLED=false
MESSAGING_PROVIDER_MICROSOFT_ENABLED=false
CALENDAR_PROVIDER_GOOGLE_ENABLED=false
CALENDAR_PROVIDER_MICROSOFT_ENABLED=false

# Uncomment when you have your own SMTP (still outbound, but to your mail host).
# EMAIL_DRIVER=smtp
# EMAIL_FROM_ADDRESS=crm@example.com
# EMAIL_FROM_NAME=Cypher CRM
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
